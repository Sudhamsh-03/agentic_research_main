# Copy to backend/.env (or export these) before starting the API.
# Placeholders only - never commit real keys.

# --- Application ---
APP_NAME=Agentic Research Dashboard
DATABASE_URL=sqlite+aiosqlite:///./app.db
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO

# --- Language model ---
# openai | google | offline
LLM_PROVIDER=offline
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
OPENAI_API_KEY=
# Optional: point at any OpenAI-compatible server, e.g. http://localhost:11434/v1
OPENAI_BASE_URL=
# Only needed when LLM_PROVIDER=google
GOOGLE_API_KEY=

# --- Web search ---
# tavily | offline
SEARCH_PROVIDER=offline
TAVILY_API_KEY=
SEARCH_RESULTS_PER_QUERY=4
SEARCH_TIMEOUT_SECONDS=20

# --- Frontend (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
